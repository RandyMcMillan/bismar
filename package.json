{
  "name": "bismar",
  "version": "0.1.6",
  "description": "Weigh, browse, and diff packages from any registry — and bundle JS ones into single-file IIFEs with min+gzip stats per export",
  "files": [
    "*.js",
    "*.d.ts",
    "vendor",
    "src/vendor/speed-highlight/LICENSE"
  ],
  "bin": {
    "bismar": "bismar.js"
  },
  "exports": {
    ".": "./public.js",
    "./env.js": "./env.js",
    "./package.json": "./package.json",
    "./public.js": "./public.js",
    "./refs.js": "./refs.js",
    "./size.js": "./size.js"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "micro-ftch": "1.1.0"
  },
  "devDependencies": {
    "@microsoft/tsdoc": "0.16.0",
    "@types/node": "24.2.1",
    "prettier": "3.6.2",
    "typescript": "6.0.2"
  },
  "scripts": {
    "build": "tsc && chmod +x bismar.js",
    "format": "npx prettier --write src/*.ts test/*.ts",
    "test": "node --test-reporter=spec --test-reporter-destination=stderr test/index.ts",
    "test:bun": "echo 'No bun'",
    "test:deno": "echo 'No deno'"
  },
  "keywords": [
    "bundle",
    "bundler",
    "size",
    "gzip",
    "esbuild",
    "iife",
    "single-file",
    "diff",
    "navigator",
    "registry",
    "npm",
    "jsr",
    "crates",
    "pypi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/bismar.git"
  },
  "type": "module",
  "main": "public.js",
  "module": "public.js",
  "types": "public.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
